%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	greeting(greeting)
	weather(weather)
	math(math)
	fallback(fallback)
	__end__([<p>__end__</p>]):::last
	__start__ --> classify;
	fallback --> __end__;
	greeting --> __end__;
	math --> __end__;
	weather --> __end__;
	classify -.-> greeting;
	classify -.-> weather;
	classify -.-> math;
	classify -.-> fallback;
	classDef default fill:#f2f0ff,line-height:1.2;
	classDef first fill-opacity:0;
	classDef last fill:#bfb6fc;
