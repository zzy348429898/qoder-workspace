{
  "name": "langgraph-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LangGraph.js 学习路线（pnpm monorepo，依赖根级统一安装）",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm -r run verify",
    "start:01": "pnpm --filter langgraph-01-basic-chatbot start",
    "start:02": "pnpm --filter langgraph-02-conditional-edges start",
    "start:03": "pnpm --filter langgraph-03-tools-function-calling start",
    "start:04": "pnpm --filter langgraph-04-react-agent start",
    "dev:01": "pnpm --filter langgraph-01-basic-chatbot dev",
    "dev:02": "pnpm --filter langgraph-02-conditional-edges dev",
    "dev:03": "pnpm --filter langgraph-03-tools-function-calling dev",
    "dev:04": "pnpm --filter langgraph-04-react-agent dev",
    "verify:01": "pnpm --filter langgraph-01-basic-chatbot verify",
    "verify:02": "pnpm --filter langgraph-02-conditional-edges verify",
    "verify:03": "pnpm --filter langgraph-03-tools-function-calling verify",
    "verify:04": "pnpm --filter langgraph-04-react-agent verify",
    "start:05": "pnpm --filter langgraph-05-checkpoint-memory start",
    "start:06": "pnpm --filter langgraph-06-human-in-the-loop start",
    "start:07": "pnpm --filter langgraph-07-subgraphs start",
    "start:08": "pnpm --filter langgraph-08-parallel-map-reduce start",
    "start:09": "pnpm --filter langgraph-09-complex-routing start",
    "start:10": "pnpm --filter langgraph-10-multi-agent-supervisor start",
    "start:11": "pnpm --filter langgraph-11-multi-agent-collaboration start",
    "start:12": "pnpm --filter langgraph-12-rag-application start",
    "start:13": "pnpm --filter langgraph-13-production-deployment start",
    "dev:05": "pnpm --filter langgraph-05-checkpoint-memory dev",
    "dev:06": "pnpm --filter langgraph-06-human-in-the-loop dev",
    "dev:07": "pnpm --filter langgraph-07-subgraphs dev",
    "dev:08": "pnpm --filter langgraph-08-parallel-map-reduce dev",
    "dev:09": "pnpm --filter langgraph-09-complex-routing dev",
    "dev:10": "pnpm --filter langgraph-10-multi-agent-supervisor dev",
    "dev:11": "pnpm --filter langgraph-11-multi-agent-collaboration dev",
    "dev:12": "pnpm --filter langgraph-12-rag-application dev",
    "dev:13": "pnpm --filter langgraph-13-production-deployment dev",
    "verify:05": "pnpm --filter langgraph-05-checkpoint-memory verify",
    "verify:06": "pnpm --filter langgraph-06-human-in-the-loop verify",
    "verify:07": "pnpm --filter langgraph-07-subgraphs verify",
    "verify:08": "pnpm --filter langgraph-08-parallel-map-reduce verify",
    "verify:09": "pnpm --filter langgraph-09-complex-routing verify",
    "verify:10": "pnpm --filter langgraph-10-multi-agent-supervisor verify",
    "verify:11": "pnpm --filter langgraph-11-multi-agent-collaboration verify",
    "verify:12": "pnpm --filter langgraph-12-rag-application verify",
    "verify:13": "pnpm --filter langgraph-13-production-deployment verify"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
